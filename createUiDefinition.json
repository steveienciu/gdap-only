{
    "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
    "handler": "Microsoft.Azure.CreateUIDef",
    "version": "0.1.2-preview",
    "parameters": {
        "config": {
            "isWizard": false,
            "basics": {
                "resourceGroup": {
                    "allowExisting": true,
                    "constraints": {
                        "required": true
                    }
                },
                "location": {
                    "label": "Deployment region",
                    "toolTip": "Region where deployment metadata is stored. This does not move or recreate your resource group."
                }
            }
        },
        "basics": [
            {
                "name": "infoBox",
                "type": "Microsoft.Common.InfoBox",
                "visible": true,
                "options": {
                    "icon": "Info",
                    "text": "This deployment assigns BlueVoyant SOC Entra group RBAC roles on an existing Microsoft Sentinel resource group. Azure Lighthouse, the Log Analytics workspace, data connectors, and Sentinel settings must already be configured before running this template."
                }
            }
        ],
        "steps": [],
        "outputs": {
            "rgName": "[resourceGroup().name]",
            "location": "[location()]"
        }
    }
}
