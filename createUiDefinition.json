{
    "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
    "handler": "Microsoft.Azure.CreateUIDef",
    "version": "0.1.2-preview",
    "parameters": {
        "config": {
            "isWizard": false,
            "basics": {
                "resourceGroup": {
                    "allowExisting": true,
                    "constraints": {
                        "required": true
                    }
                }
            }
        },
        "basics": [
            {
                "name": "infoBox",
                "type": "Microsoft.Common.InfoBox",
                "visible": true,
                "options": {
                    "icon": "Info",
                    "text": "Select the existing resource group that contains your Microsoft Sentinel workspace. This deployment assigns BlueVoyant SOC Entra group RBAC roles on that resource group. Azure Lighthouse, data connectors, and Sentinel settings must already be configured."
                }
            }
        ],
        "steps": [],
        "outputs": {}
    }
}
